{
  "name": "copybiblioteket",
  "version": "1.0.0",
  "description": "A source-backed copy library with original Swedish applications, Hormozi, Cialdini and a Copy Operator skill.",
  "license": "MIT",
  "homepage": "https://sigge.si",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ac0AI/copybiblioteket.git"
  },
  "bugs": {
    "url": "https://github.com/Ac0AI/copybiblioteket/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "chatgpt",
    "founders",
    "startups",
    "knowledge-base",
    "rag"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch copy/start.ts",
    "start": "tsx copy/start.ts",
    "typecheck": "tsc --noEmit",
    "mcp": "tsx copy/mcp.ts",
    "search": "tsx copy/cli.ts",
    "test": "tsx --test copy/tests/*.test.ts",
    "smoke": "tsx --test copy/tests/http.test.ts copy/tests/mcp.test.ts",
    "build": "npm run typecheck && npm run build:client && npm test",
    "build:client": "esbuild client/studio.js --bundle --format=esm --target=es2022 --minify --outfile=public/studio-app.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vercel/oidc": "^4.0.4",
    "express": "^4.21.2",
    "tsx": "^4.19.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    }
  }
}
